# Create .env.local from this file. Never commit real secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

DATABASE_URL=postgresql://superbot:superbot@localhost:5432/superbot
DATABASE_SSL=false
RATE_LIMIT_SALT=replace-with-another-random-secret

# Daily message allowance for authenticated free accounts.
FREE_DAILY_MESSAGES=50
